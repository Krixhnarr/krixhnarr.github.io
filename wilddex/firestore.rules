// Firestore security rules for WildDex cloud saves. Paste into Firebase console
// → Firestore Database → Rules, then Publish. Each player can only read and
// write their own save document: players/{their uid}.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'savedAt', 'updatedAt', 'v'])
        && request.resource.data.state is string && request.resource.data.state.size() < 900000;
    }
  }
}
